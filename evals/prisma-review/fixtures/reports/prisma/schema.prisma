datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Customer {
  id           Int     @id @default(autoincrement())
  tenantId     Int
  email        String  @unique
  passwordHash String
  orders       Order[]
}

model Order {
  id         Int         @id @default(autoincrement())
  tenantId   Int
  customerId Int
  status     String
  customer   Customer    @relation(fields: [customerId], references: [id])
  items      OrderItem[]

  @@index([tenantId, id])
}

model OrderItem {
  id       Int    @id @default(autoincrement())
  orderId  Int
  sku      String
  quantity Int
  order    Order  @relation(fields: [orderId], references: [id])

  @@index([orderId])
}
