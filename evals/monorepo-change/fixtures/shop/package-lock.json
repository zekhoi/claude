{
  "name": "shop",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "shop",
      "workspaces": [
        "packages/*"
      ]
    },
    "node_modules/@shop/billing": {
      "resolved": "packages/billing",
      "link": true
    },
    "node_modules/@shop/money": {
      "resolved": "packages/money",
      "link": true
    },
    "node_modules/@shop/web": {
      "resolved": "packages/web",
      "link": true
    },
    "packages/billing": {
      "name": "@shop/billing",
      "version": "1.0.0",
      "dependencies": {
        "@shop/money": "*"
      }
    },
    "packages/money": {
      "name": "@shop/money",
      "version": "1.0.0"
    },
    "packages/web": {
      "name": "@shop/web",
      "version": "1.0.0"
    }
  }
}
